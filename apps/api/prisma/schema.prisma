generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model SyncEpoch {
  id    Int    @id @db.SmallInt
  epoch String @db.Uuid

  @@map("sync_epoch")
  @@schema("app")
}

model OpsSettings {
  id                      Int       @id @db.SmallInt
  orphanDeletePausedUntil DateTime? @map("orphan_delete_paused_until") @db.Timestamptz
  orphanReviewRequired    Boolean   @default(false) @map("orphan_review_required")
  bulkEmailPaused         Boolean   @default(false) @map("bulk_email_paused")
  lastRestoreAt           DateTime? @map("last_restore_at") @db.Timestamptz
  lastRestoreBackupAt     DateTime? @map("last_restore_backup_at") @db.Timestamptz

  @@map("ops_settings")
  @@schema("app")
}

enum GlobalRole {
  USER
  ADMIN

  @@map("global_role")
  @@schema("app")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
  @@schema("app")
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGED
  ROLE_CHANGED
  SUSPENDED
  ANONYMIZED
  EMAIL_CHANGED
  ADMIN_REVOKED
  OTHER_DEVICES
  RESTORE

  @@map("session_revoke_reason")
  @@schema("app")
}

model User {
  id                    String                @id @db.Uuid
  email                 String?               @unique
  firstName             String?               @map("first_name")
  lastName              String?               @map("last_name")
  passwordHash          String?               @map("password_hash")
  globalRole            GlobalRole            @default(USER) @map("global_role")
  status                UserStatus            @default(ACTIVE)
  emailFlaggedAt        DateTime?             @map("email_flagged_at") @db.Timestamptz
  emailReminders        Boolean               @default(true) @map("email_reminders")
  emailAnnouncements    Boolean               @default(true) @map("email_announcements")
  unsubscribeTokenHash  Bytes?                @map("unsubscribe_token_hash")
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  sessions              Session[]
  emails                EmailOutbox[]
  secondFactorBlockedAt DateTime?             @map("second_factor_blocked_at") @db.Timestamptz
  secondFactorClearedAt DateTime?             @map("second_factor_cleared_at") @db.Timestamptz
  authChallenges        AuthChallenge[]
  secondFactorFailures  SecondFactorFailure[]
  passwordResetTokens   PasswordResetToken[]

  @@map("users")
  @@schema("app")
}

model Session {
  id                 String               @id @db.Uuid
  tokenHash          Bytes                @unique @map("token_hash")
  userId             String               @map("user_id") @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt         DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz
  idleExpiresAt      DateTime             @map("idle_expires_at") @db.Timestamptz
  absoluteExpiresAt  DateTime             @map("absolute_expires_at") @db.Timestamptz
  reauthAt           DateTime?            @map("reauth_at") @db.Timestamptz
  ip                 String?              @db.Inet
  userAgent          String?              @map("user_agent")
  revokedAt          DateTime?            @map("revoked_at") @db.Timestamptz
  revokeReason       SessionRevokeReason? @map("revoke_reason")
  secondFactorAt     DateTime?            @map("second_factor_at") @db.Timestamptz
  secondFactorMethod String?              @map("second_factor_method")
  stepUpAt           DateTime?            @map("step_up_at") @db.Timestamptz
  authChallenges     AuthChallenge[]

  @@map("sessions")
  @@schema("app")
}

enum ClassStatus {
  ACTIVE
  ARCHIVED

  @@map("class_status")
  @@schema("app")
}

enum EnrollmentStatus {
  PENDING
  ACCEPTED
  REFUSED

  @@map("enrollment_status")
  @@schema("app")
}

enum AuditSource {
  APP
  PRIVILEGED

  @@map("audit_source")
  @@schema("app")
}

enum AuditAction {
  ADMIN_CREATED
  CLASS_CREATED
  ACCOUNT_REGISTERED
  PASSWORD_CHANGED
  SESSIONS_REVOKED
  ACCOUNT_ANONYMIZED
  NOTIFICATIONS_PURGED
  CHAT_PURGED
  ADMIN_RECOVERY_CODE_ISSUED
  ADMIN_SECOND_FACTOR_BLOCK_CLEARED
  DATABASE_RESTORED
  ADMIN_LOGIN
  ADMIN_EMAIL_CHANGED
  PASSWORD_RESET_COMPLETED
  ADMIN_SECOND_FACTOR_BLOCKED

  @@map("audit_action")
  @@schema("app")
}

model Class {
  id           String      @id @db.Uuid
  name         String
  level        String
  academicYear String      @map("academic_year")
  status       ClassStatus @default(ACTIVE)
  archivedAt   DateTime?   @map("archived_at") @db.Timestamptz
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([name, academicYear])
  @@map("classes")
  @@schema("app")
}

model EnrollmentRequest {
  id           String           @id @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  classId      String           @map("class_id") @db.Uuid
  status       EnrollmentStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz
  decidedBy    String?          @map("decided_by") @db.Uuid
  decisionNote String?          @map("decision_note")

  @@map("enrollment_requests")
  @@schema("app")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz
  source      AuditSource @default(APP)
  dbLoginRole String      @default(dbgenerated("SESSION_USER")) @map("db_login_role")
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  targetType  String?     @map("target_type")
  targetId    String?     @map("target_id") @db.Uuid
  metadata    Json        @default("{}")

  @@map("audit_log")
  @@schema("app")
}

enum ChallengePurpose {
  LOGIN
  RECOVERY
  STEP_UP
  EMAIL_CHANGE_OLD
  EMAIL_CHANGE_NEW

  @@map("challenge_purpose")
  @@schema("app")
}

enum ChallengeConsumedReason {
  USED
  EXPIRED
  SUPERSEDED
  LOCKED
  SESSION_ENDED

  @@map("challenge_consumed_reason")
  @@schema("app")
}

model AuthChallenge {
  id             String                   @id @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose        ChallengePurpose
  sessionId      String?                  @map("session_id") @db.Uuid
  session        Session?                 @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash      Bytes?                   @map("token_hash")
  codeHmac       Bytes                    @map("code_hmac")
  pendingEmail   String?                  @map("pending_email")
  ip             String?                  @db.Inet
  attempts       Int                      @default(0) @db.SmallInt
  createdAt      DateTime                 @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  expiresAt      DateTime                 @map("expires_at") @db.Timestamptz
  consumedAt     DateTime?                @map("consumed_at") @db.Timestamptz
  consumedReason ChallengeConsumedReason? @map("consumed_reason")
  emails         EmailOutbox[]

  @@index([userId, createdAt], map: "auth_challenges_user_created_idx")
  @@map("auth_challenges")
  @@schema("app")
}

model SecondFactorFailure {
  id          BigInt           @id @default(autoincrement())
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  challengeId String?          @map("challenge_id") @db.Uuid
  purpose     ChallengePurpose
  occurredAt  DateTime         @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz

  @@index([userId, occurredAt], map: "second_factor_failures_user_idx")
  @@map("second_factor_failures")
  @@schema("app")
}

model PasswordResetToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash  Bytes     @unique(map: "password_reset_token_hash_key") @map("token_hash")
  createdAt  DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz

  @@map("password_reset_tokens")
  @@schema("app")
}

enum EmailKind {
  WELCOME
  REFUSAL
  PASSWORD_RESET
  DIGEST
  ANNOUNCEMENT
  ADMIN_ALERT
  SECURITY_ALERT
  ADMIN_SECURITY_ALERT
  ADMIN_OTP
  ADMIN_EMAIL_CHANGE_OLD
  ADMIN_EMAIL_CHANGE_NEW
  TEST

  @@map("email_kind")
  @@schema("app")
}

enum EmailStatus {
  PENDING
  SENDING
  RETRY_WAIT
  UNCERTAIN
  ACCEPTED
  FAILED
  EXPIRED
  CANCELLED

  @@map("email_status")
  @@schema("app")
}

enum EmailAttemptKind {
  NORMAL
  AMBIGUOUS_RETRY

  @@map("email_attempt_kind")
  @@schema("app")
}

enum EmailAttemptOutcome {
  ACCEPTED
  TEMP_FAIL
  PERM_FAIL
  AMBIGUOUS
  CANCELLED_IN_FLIGHT

  @@map("email_attempt_outcome")
  @@schema("app")
}

model EmailOutbox {
  id                      String         @id @db.Uuid
  recipientUserId         String?        @map("recipient_user_id") @db.Uuid
  recipient               User?          @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  toAddress               String         @map("to_address")
  kind                    EmailKind
  dedupeKey               String         @unique(map: "email_outbox_dedupe_key_key") @map("dedupe_key")
  payload                 Json           @default("{}")
  payloadEncrypted        Bytes?         @map("payload_encrypted")
  messageId               String         @unique(map: "email_outbox_message_id_key") @map("message_id")
  status                  EmailStatus    @default(PENDING)
  normalAttempts          Int            @default(0) @map("normal_attempts") @db.SmallInt
  ambiguousRetryScheduled Boolean        @default(false) @map("ambiguous_retry_scheduled")
  ambiguousRetryClaimed   Boolean        @default(false) @map("ambiguous_retry_claimed")
  nextAttemptAt           DateTime       @default(dbgenerated("clock_timestamp()")) @map("next_attempt_at") @db.Timestamptz
  lockedUntil             DateTime?      @map("locked_until") @db.Timestamptz
  claimToken              String?        @map("claim_token") @db.Uuid
  expiresAt               DateTime       @map("expires_at") @db.Timestamptz
  acceptedAt              DateTime?      @map("accepted_at") @db.Timestamptz
  challengeId             String?        @map("challenge_id") @db.Uuid
  challenge               AuthChallenge? @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  createdAt               DateTime       @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  attempts                EmailAttempt[]

  @@index([nextAttemptAt], map: "email_outbox_due_idx")
  @@index([lockedUntil], map: "email_outbox_sending_idx")
  @@map("email_outbox")
  @@schema("app")
}

model EmailAttempt {
  id           BigInt               @id @default(autoincrement())
  emailId      String               @map("email_id") @db.Uuid
  email        EmailOutbox          @relation(fields: [emailId], references: [id], onDelete: Restrict)
  attemptNo    Int                  @map("attempt_no") @db.SmallInt
  kind         EmailAttemptKind
  claimToken   String               @map("claim_token") @db.Uuid
  startedAt    DateTime             @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz
  finishedAt   DateTime?            @map("finished_at") @db.Timestamptz
  outcome      EmailAttemptOutcome?
  smtpCode     Int?                 @map("smtp_code")
  smtpResponse String?              @map("smtp_response")
  errorCode    String?              @map("error_code")
  lateOutcome  EmailAttemptOutcome? @map("late_outcome")
  lateSmtpCode Int?                 @map("late_smtp_code")

  @@unique([emailId, attemptNo], map: "email_attempts_email_no_key")
  @@map("email_attempts")
  @@schema("app")
}

model JobLease {
  name         String    @id
  holder       String?
  leaseUntil   DateTime? @map("lease_until") @db.Timestamptz
  fencingToken BigInt    @default(0) @map("fencing_token")

  @@map("job_leases")
  @@schema("app")
}
